# Cache and security headers.
#
# Read natively by Netlify and Cloudflare Pages. GitHub Pages ignores this
# file entirely — it serves everything with a 10-minute cache and no custom
# headers, which is the main reason to prefer one of the other two.
#
# The caching split matters: the JS filename carries a content hash, so it can
# be cached for a year and a redeploy still busts it. HTML must never be cached
# hard, or a publish takes hours to reach readers.

/*
  # Matches ALLOW_SEARCH_INDEXING = False in build.py. Remove this line when
  # you open the site, or the header will keep it out of the index no matter
  # what the meta tags say.
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# Hashed filename — safe to cache forever.
/assets/js/bundle.*.min.js
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames that can change in place. A week is the compromise.
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/og/*
  Cache-Control: public, max-age=604800

# HTML: always revalidate. The CSS is inlined into these, so a style change
# ships with the page and there is no separate stylesheet to bust.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Discovery files: crawlers re-fetch these, an hour is plenty.
/sitemap.xml
  Cache-Control: public, max-age=3600
/feed.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600

# No Content-Security-Policy here on purpose. The pages carry an inline theme
# script (it has to run before first paint to avoid a flash) and inlined CSS,
# so any CSP would need 'unsafe-inline' for both and would buy little. Adding
# one properly means hashing those inline blocks at build time — worth doing
# if the site ever takes user input, which it currently does not.
